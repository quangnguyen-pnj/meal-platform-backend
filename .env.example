# Copy this file to .env and adjust values for your local environment.
# Do NOT commit a real .env file.

# ---- Application ----
# HTTP port the NestJS server listens on.
PORT=3000
# Node environment: development | test | production
NODE_ENV=development

# ---- Database (PostgreSQL via docker-compose) ----
# These three values are consumed by docker-compose.yml to provision the
# local PostgreSQL container.
POSTGRES_USER=meal_platform
POSTGRES_PASSWORD=meal_platform
POSTGRES_DB=meal_platform
# Host port the Postgres container is published on.
POSTGRES_PORT=5432

# Connection string used by Prisma. Keep host/port/credentials in sync with
# the POSTGRES_* values above when running the Compose database locally.
DATABASE_URL=postgresql://meal_platform:meal_platform@localhost:5432/meal_platform?schema=public

# ---- Auth / JWT ----
# Secret used to sign and verify JWT access and refresh tokens. Use a long,
# random value locally. Never commit a real secret; this is an example only.
JWT_SECRET=ChangeMe_Local_JWT_Secret_At_Least_32_Chars
# Access-token lifetime in seconds (short-lived). Default 15 minutes.
JWT_ACCESS_TTL_SECONDS=900
# Refresh-token lifetime in seconds. Default 30 days.
JWT_REFRESH_TTL_SECONDS=2592000
# Comma-separated list of allowed web origins for CORS.
WEB_ORIGIN=http://localhost:3001

# ---- Seed ----
# Password applied to every seeded local account (Argon2id hashed by the seed).
# Set a local value before running `npm run prisma:seed`. Never commit a real
# secret; this placeholder is only an example.
SEED_PASSWORD=ChangeMe_Local_Only_123
